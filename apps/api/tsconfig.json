{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "paths": {
      "@isekai/contracts": ["../packages/contracts/src"],
      "@isekai/game-core": ["../packages/game-core/src"],
      "@isekai/ai-core": ["../packages/ai-core/src"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../../packages/contracts" },
    { "path": "../../packages/game-core" },
    { "path": "../../packages/ai-core" }
  ]
}
