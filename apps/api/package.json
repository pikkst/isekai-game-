{
  "name": "@isekai/api",
  "version": "0.1.0",
  "description": "Express HTTP backend for Isekai Life RPG",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc -b --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@isekai/contracts": "file:../../packages/contracts",
    "@isekai/game-core": "file:../../packages/game-core",
    "@isekai/ai-core": "file:../../packages/ai-core",
    "dotenv": "^17.2.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}