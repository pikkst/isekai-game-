{
  "name": "isekai-life-rpg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:contracts && npm run build:game-core && npm run build:ai-core && npm run build:api && npm run build:web",
    "build:contracts": "cd packages/contracts && npm run build",
    "build:game-core": "cd packages/game-core && npm run build",
    "build:ai-core": "cd packages/ai-core && npm run build",
    "build:api": "cd apps/api && npm run build",
    "build:web": "cd apps/web && npm run build",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "cd apps/api && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "typecheck": "tsc -b",
    "clean": "npm run clean:contracts && npm run clean:game-core && npm run clean:ai-core && npm run clean:api && npm run clean:web",
    "clean:contracts": "cd packages/contracts && npm run clean",
    "clean:game-core": "cd packages/game-core && npm run clean",
    "clean:ai-core": "cd packages/ai-core && npm run clean",
    "clean:api": "cd apps/api && npm run clean",
    "clean:web": "cd apps/web && npm run clean"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^9.2.4",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}
