# GEMINI_API_KEY: Required for Gemini AI API calls on the backend.
# Generate via https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Port for the API server (default: 3000)
PORT=3000

# APP_URL: The URL where the web client is hosted.
APP_URL="http://localhost:5173"

# WEB_PORT: Port for the web dev server (default: 5173)
WEB_PORT=5173
